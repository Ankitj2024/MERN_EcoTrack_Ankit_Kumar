# ─── Required ────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens
JWT_SECRET=ecotrack_super_secret_jwt_key_2026_dev

# MongoDB Atlas connection string
# Leave empty to use the in-memory database during development
MONGO_URI=""

# Environment
NODE_ENV=development

# Port
PORT=3000

# ─── Optional & Integrations ─────────────────────────────────────────────────

# Public URL of the application (optional)
APP_URL=http://localhost:3000

# Google OAuth 2.0 Client ID (Backend verification & Frontend SDK)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Email Settings (For sending password reset OTP emails)
# Option 1 (Recommended on Render Free Tier): Resend HTTPS API (Port 443 - never blocked)
RESEND_API_KEY=

# Option 2: Standard SMTP Settings
# If left empty, OTPs will be displayed directly in the server terminal for quick testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EcoTrack Security <no-reply@ecotrack.local>"